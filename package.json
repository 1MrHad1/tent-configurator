{
  "name": "tent-configurator",
  "version": "1.0.0",
  "description": "Embeddable 2D/3D canopy tent configurator with API pricing, Shopify cart hand-off and a production PDF (React + TypeScript + Three.js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:models": "node scripts/build-models.ts && node scripts/build-banner.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "author": "Haseeb Ahmed Danish",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "jspdf": "^4.2.1",
    "konva": "^10.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@netlify/blobs": "^11.1.3",
    "@netlify/functions": "^6.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.86.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true
}
